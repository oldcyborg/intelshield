# Cấu hình IntelShield trên VPS. deploy/vps/install.sh chép tệp này thành deploy/.env
# lần đầu (thay __RANDOM__ bằng chuỗi ngẫu nhiên) rồi dừng để bạn điền DOMAIN.
# KHÔNG commit tệp .env.

# ── Phần bạn điền ────────────────────────────────────────────────────────────
# Tên miền đã trỏ DNS (bản ghi A) về IP của VPS, ví dụ intelshield.congty.vn
DOMAIN=intelshield.example.com
# Email nhận thông báo của Let's Encrypt. Để trống: chỉ chạy HTTP (không nên — app Android cần HTTPS).
LETSENCRYPT_EMAIL=
# yes: dựng một công ty demo để bấm thử (dựng lại bất kỳ lúc nào ở /resetdemo?key=DEMO_RESET_KEY).
SEED_DEMO=no

# Cổng nội bộ trên 127.0.0.1 — nginx của máy chủ chuyển tên miền vào đây. Đổi nếu đã bị dùng.
WEB_PORT=5000
API_PORT=5001

# ── Phần script tự điền ──────────────────────────────────────────────────────
DB_USERNAME=intelshield
DB_PASSWORD=__RANDOM__
DB_DATABASE=intelshield

# Ít nhất 32 ký tự, ngẫu nhiên. Đổi khóa này là đăng xuất mọi người.
JWT_SECRET=__RANDOM__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10

# Web quản lý + app Android (Capacitor chạy ở https://localhost). install.sh ghi lại theo DOMAIN.
CORS_ORIGIN=https://intelshield.example.com,https://localhost

# Tài khoản quản trị nền tảng (tạo công ty mới). Mật khẩu ít nhất 12 ký tự.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=__RANDOM__

# Khoá dịch vụ Firebase (nội dung JSON trên MỘT dòng). Để trống: thông báo vẫn có trong app/web, chưa đẩy tới điện thoại.
FCM_SERVICE_ACCOUNT=
PUSH_DRIVER=

ESCALATION_TICK=on
PATROL_TICK=on
VIOLATION_TICK=on
HANDOVER_TICK=on
# Trang /resetdemo?key=... dựng lại công ty demo. Để trống = tắt trang này. Chỉ gửi link cho người được phép.
DEMO_RESET_KEY=
