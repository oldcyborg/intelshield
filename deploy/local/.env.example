# Cấu hình bản chạy trên máy. start.sh / start.ps1 chép tệp này thành .env lần đầu
# và thay mọi giá trị __RANDOM__ bằng chuỗi ngẫu nhiên. Không commit tệp .env.

# Trang quản lý: http://localhost:8082 · app điện thoại (bản trình duyệt): http://localhost:8083
WEB_PORT=8082
MOBILE_PORT=8083

DB_USERNAME=intelshield
DB_PASSWORD=__RANDOM__
DB_DATABASE=intelshield

JWT_SECRET=__RANDOM__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10

# Tài khoản quản trị nền tảng (tạo công ty mới qua POST /api/platform/tenants).
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=__RANDOM__

# Firebase (JSON trên một dòng) để đẩy thông báo tới điện thoại. Để trống: thông báo chỉ hiện trong app/web.
FCM_SERVICE_ACCOUNT=
PUSH_DRIVER=

ESCALATION_TICK=on
PATROL_TICK=on
VIOLATION_TICK=on
HANDOVER_TICK=on

# Trang /resetdemo?key=... dựng lại công ty demo. Để trống = tắt trang này.
DEMO_RESET_KEY=__RANDOM__
