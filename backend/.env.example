NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=patrol
DB_PASSWORD=patrol
DB_DATABASE=patrol
JWT_SECRET=dev-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10
# Chỉ cần khi app di động gọi thẳng API (Plan 03). Không bao giờ để "*".
# Web quản lý, app Android (https://localhost), Vite khi phát triển app (http://localhost:5173)
CORS_ORIGIN=http://localhost:3000,https://localhost,http://localhost:5173
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
UPLOAD_DIR=./uploads
# Khoá dịch vụ Firebase (nội dung JSON, một dòng). Để trống: thông báo vẫn lưu và hiện trên web, chưa đẩy tới điện thoại.
FCM_SERVICE_ACCOUNT=
# fcm | log | memory (test). Để trống thì tự chọn theo FCM_SERVICE_ACCOUNT.
PUSH_DRIVER=
# on | off — vòng quét leo thang sự cố mỗi phút.
ESCALATION_TICK=on
# on | off — vòng quét tuần tra mỗi phút (sinh vòng, nhắc, chốt bỏ lỡ).
PATROL_TICK=on
# on | off — vòng quét vi phạm mỗi phút.
VIOLATION_TICK=on
# on | off — nhắc giao ca chưa xác nhận.
HANDOVER_TICK=on
# Trang /resetdemo?key=... dựng lại công ty demo. Để trống = tắt trang này. Chuỗi ngẫu nhiên, chỉ gửi link cho người được phép.
DEMO_RESET_KEY=
